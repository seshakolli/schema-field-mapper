# Which model runtime to use.
#   claude-code   (default) shells out to the Claude Code CLI; needs NO API key
#   anthropic-api uses the Anthropic SDK; needs ANTHROPIC_API_KEY below
LLM_BACKEND=claude-code

# Model for either backend. Accepts a full id or a Claude Code alias.
CLAUDE_MODEL=claude-sonnet-5

# Path to the Claude Code binary, if it is not on PATH.
# CLAUDE_CLI=/usr/local/bin/claude

# Required only when LLM_BACKEND=anthropic-api.
# ANTHROPIC_API_KEY=sk-ant-...
